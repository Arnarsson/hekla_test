# HEKLA Environment Configuration
# https://www.hekla.cc/
# Copy to .env and run: ./scripts/setup.sh

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# OLLAMA (runs natively on macOS, NOT in Docker)
# ============================================
# Docker containers reach host Ollama via host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434

# ============================================
# MODEL CONFIGURATION
# ============================================
# Mac Mini M4 tiers (setup.sh auto-detects):
#   base  (16GB M4):      qwen2.5:7b   — core PA tasks
#   base+ (24GB):         qwen2.5:14b  — better reasoning
#   pro   (36GB M4 Pro):  qwen2.5:32b  — full capability
#   max   (64GB+ M4 Max): llama3.3:70b — near-SOTA
ACTIVE_MODEL=qwen2.5:7b

# ============================================
# LANGFUSE OBSERVABILITY
# ============================================
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
LANGFUSE_SALT=generate_with_openssl_rand_base64_32

# ============================================
# AZURE/MICROSOFT OAUTH (Phase 2)
# ============================================
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# ============================================
# TELEGRAM BOT (Phase 2)
# ============================================
BOT_TOKEN=

# ============================================
# HYBRID MODE (Phase 4 — subscription)
# ============================================
# When enabled, overflow complex tasks to OpenRouter
HYBRID_MODE=false
OPENROUTER_API_KEY=

# ============================================
# ALTERNATIVE SOLUTIONS (Phase 4 — subscription)
# ============================================
# Mail forwarding service (instead of OAuth)
MAIL_FORWARD_ENABLED=false
MAIL_FORWARD_ADDRESS=

# ============================================
# DEVICE INFO
# ============================================
DEVICE_NAME=hekla-dev
DEVICE_SERIAL=
DEVICE_TIER=pro
