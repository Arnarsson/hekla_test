# HEKLA Environment Configuration
# Copy to .env and fill in values

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# MODEL CONFIGURATION
# ============================================
# Options: qwen2.5:14b (16-24GB), qwen2.5:32b (36GB), llama3.3:70b (64GB+)
ACTIVE_MODEL=qwen2.5:14b

# ============================================
# LANGFUSE OBSERVABILITY
# ============================================
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
LANGFUSE_SALT=generate_with_openssl_rand_base64_32

# ============================================
# AZURE/MICROSOFT OAUTH (Phase 2)
# ============================================
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# ============================================
# TELEGRAM BOT (Phase 2)
# ============================================
BOT_TOKEN=

# ============================================
# HYBRID MODE (Phase 4)
# ============================================
HYBRID_MODE=false
OPENROUTER_API_KEY=

# ============================================
# DEVICE INFO
# ============================================
DEVICE_NAME=hekla-dev
DEVICE_SERIAL=
DEVICE_TIER=personal
